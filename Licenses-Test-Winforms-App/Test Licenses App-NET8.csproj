<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Perpetual_Test_App_NET8</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published SDK from nuget.org, as vendors install it. To try SDK changes that are not published yet, use
         <ProjectReference Include="..\..\LicenPro-2024\SDK\LicenPro.SDK.lib\LicenPro.SDK.csproj" />
         instead of this line, and put the line back before committing. -->
    <PackageReference Include="LicenPro.SDK" Version="1.14.0" />
  </ItemGroup>



  <ItemGroup>
    <None Update="licenpro.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The product public key is built into the app (BUG-12); customers enter only their license key. Copy
         LicenPro.PublicKey.example.txt to LicenPro.PublicKey.txt (git-ignored, so no key is committed) and paste the key
         from Dashboard > Product > Settings > RSA keys > Build into your app. The SDK reads this embedded resource
         when LicenseClientOptions.PublicKey is empty. -->
    <EmbeddedResource Include="LicenPro.PublicKey.txt" LogicalName="LicenPro.PublicKey.txt" Condition="Exists('LicenPro.PublicKey.txt')" />
  </ItemGroup>

</Project>
